# Know Your Company - configuration. Copy to .env (setup_windows.bat does this for you).
# No API keys are needed or used. Everything runs locally and costs nothing.

# ---- Local LLM (Ollama) ----
OLLAMA_BASE_URL=http://localhost:11434
# Pick a SMALL model for an 8 GB RAM / CPU-only laptop. See OLLAMA_SETUP.md.
OLLAMA_MODEL=qwen3:1.7b
# Seconds to wait for a reply. CPU inference is slow; raise this if you see timeouts.
OLLAMA_TIMEOUT=300
# Context window. Keep small on 8 GB RAM.
OLLAMA_NUM_CTX=4096

# ---- Local embeddings (sentence-transformers) ----
# Downloaded once on first use (~130 MB), then cached by sentence-transformers.
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# auto = use the model, fall back to a built-in keyword embedder if it cannot load
# hash = always use the keyword embedder (no download; lower retrieval quality)
EMBEDDING_BACKEND=auto

# ---- Retrieval / chunking (sizes are approximate tokens) ----
TOP_K=5
CHUNK_SIZE=500
CHUNK_OVERLAP=60
# Chunks scoring below this cosine similarity are ignored. Not calibrated for every model:
# the chat shows per-chunk scores so you can tune it. Keyword fallback uses its own lower default.
MIN_SCORE=0.10
MAX_CONTEXT_CHARS=6000

# ---- Research limits (kept small on purpose) ----
MAX_WEBSITE_PAGES=8
MAX_SEARCH_QUERIES=10
MAX_RESULTS_PER_QUERY=5
MAX_SOURCE_PAGES=12
REQUEST_TIMEOUT=12

# ---- Storage (optional) ----
# DATA_DIR=./data
